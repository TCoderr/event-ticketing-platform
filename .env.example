# Loca — yapılandırma örneği (YER TUTUCULAR; gerçek secret içermez).
#
# Yerel stack için bu dosyaya ihtiyaç yoktur: scripts/local-stack.ps1 (veya .sh) secret'ları kendisi üretir ve
# .local/<proje>/ altındaki özel dosyalara yazar; Compose bu dosyaları "secrets" olarak bağlar.
# Aşağıdaki değişkenler yalnız varsayılanları değiştirmek isteyenler içindir (kabukta dışa aktarın).

# Yayınlanan HTTPS portu (betiğin -HttpsPort / --https-port parametresi bunu ayarlar).
LOCA_HTTPS_PORT=8643

# Kullanılacak imaj etiketi.
LOCA_IMAGE=loca-api:local

# --- Yalnız izole E2E stack'i için (web/e2e/run-e2e.mjs bunları kendisi verir) ---
# LOCA_HOLDS_MIN_TTL_SECONDS=120
# LOCA_PSP_LATE_SUCCESS_DELAY_SECONDS=900
# LOCA_DEMO_CROWD_ENABLED=true
# LOCA_RATE_LOGIN_PER_MINUTE=10

# --- Uygulama ayarları (ASP.NET Core yapılandırma anahtarları; konteynerde ortam değişkeni olarak) ---
# Secret'lar DEĞER olarak değil, DOSYA YOLU olarak verilir:
# Database__Host=postgres
# Database__Name=loca
# Database__AppUser=loca_app
# Database__AppPasswordFile=/run/secrets/db_app_password
# Database__OwnerUser=loca_owner
# Database__OwnerPasswordFile=/run/secrets/db_owner_password
# Psp__BaseUrl=<ödeme sağlayıcısı taban adresi>
# Psp__ApiKeyFile=/run/secrets/psp_api_key
# Psp__WebhookSecretFiles__0=/run/secrets/psp_webhook_secret
# Psp__WebhookSecretFiles__1=<rotasyon sırasında önceki secret dosyası>
# Hosting__HttpsPort=8443
# Hosting__CertificatePfxPath=<sertifika dosyası>
# Hosting__CertificatePasswordFile=<sertifika parolası dosyası>
# DataProtection__KeysDirectory=/var/lib/loca/keys/data-protection
# Demo__SeedEnabled=false
# Demo__SimulatorEnabled=false
